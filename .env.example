# ==========================================
# 🏭 Bot Factory — فایل نمونه تنظیمات
# کپی کنید:  cp .env.example .env  و مقدارها را پر کنید
# ⚠️ بعد از پر کردن:  chmod 600 .env
# ==========================================

# --- ربات فروش (از BotFather بگیرید) ---
SALES_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=123456789,987654321

# --- MySQL مشترک ---
MYSQL_ROOT_PASS=یک-رمز-قوی-و-یکتا
FACTORY_APP_USER=factory_app
FACTORY_APP_PASS=رمز-قوی-دوم
DB_NAME=bot_factory
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_CONTAINER=factory_mysql
# ⚠️ باید با max_connections فایل my.cnf یکی باشد
# سقف اینستنس‌های فعال = (1000-50)÷(5+10) = ۶۳ ← آماده ۵۰ سفارش همزمان
MYSQL_MAX_CONNECTIONS=1000
MYSQL_RESERVE_CONN=50
# --- Redis (هر کانتینر ۱۵ اسلات؛ 4 کانتینر = ۶۰ اینستنس — آماده ۵۰ سفارش همزمان) ---
# ⚠️ اگر NUM_REDIS را تغییر دادید: docker compose up -d و سپس ری‌استارت ربات
REDIS_PASS=رمز-redis
NUM_REDIS=4

# --- مسیرها و ایمیج ---
FACTORY_DIR=/opt/factory
BOT_IMAGE=sender_bot:v1

# --- پرداخت (اطلاعات کارت برای مشتری — صفحه «شارژ حساب») ---
PAYMENT_CARD=6037-9999-9999-9999
PAYMENT_CARD_HOLDER=نام صاحب کارت
PAYMENT_NOTE=بعد از واریز، تصویر رسید را همینجا بفرستید.

# --- واحد پول نمایشی قیمت‌ها و کیف پول ---
# قیمت‌ها همیشه به «سنت» ذخیره می‌شوند (۳.۵ دلار = 350) و در نمایش خودکار به دلار تبدیل می‌شوند.
CURRENCY=دلار

# --- پشتیبانی (نمایش در صفحات شارژ/اکانت مجازی/قوانین/سفارش PV) ---
SUPPORT_USERNAME=@support_admin
# سقف سفارش «در انتظار تأیید» به ازای هر کاربر (ضد اسپام؛ مانع ۵۰ مشتری مختلف نیست)
MAX_PENDING_ORDERS=3


# --- 🛒 ربات خرید شماره مجازی (نسخه ۳) ---
# دکمه شیشه‌ای صفحه «📱 نیاز به اکانت تلگرامی؟» به این لینک اشاره می‌کند
# (به‌جای دکمه پشتیبانی — طبق خواسته کارفرما)
VIRTUAL_NUMBER_BOT=@PlusNumberBot

# --- 🎬 ویدیوی آموزشی توکن (نسخه ۳) ---
# راه توصیه‌شده: پنل ادمین → «🎬 ویدیوی آموزشی توکن» → آپلود مستقیم ویدیو
# (ذخیره در دیتابیس؛ از همان لحظه خودکار همراه متن‌های راهنما ارسال می‌شود)
# این متغیر فقط fallback اولیه است — خالی = فعلاً بدون ویدیو (بدون خطا)
# پیشوند نوع اختیاری: animation:<file_id> یا document:<file_id>
TOKEN_GUIDE_VIDEO_FILE_ID=

# --- 🔧 حالت ساخت دستی (نسخه ۳) ---
# true  = سفارش پرداخت‌شده به‌جای دیپلوی خودکار، به پشتیبانی ارجاع می‌شود؛
#         پشتیبانی ایمیج ربات را می‌سازد و از پنل وضعیت را به‌روز می‌کند
# false = رفتار قدیمی: پرداخت از کیف پول → ساخت خودکار فوری
MANUAL_BUILD_MODE=true

# --- شماره مجازی ---
# فروش شماره مجازی به تیم Plus Number ارجاع شده؛ فان سندر خودش شماره نمی‌فروشد
# (متن صفحه «📱 نیاز به اکانت تلگرامی؟» در bot/handlers/info_pages.py — TEXT_VIRTUAL)

# --- 🎬 ویدیوی آموزشی ربات سندر ---
# به .env هر اینستنس تازه‌ساخته کپی می‌شود و دکمه «🎥 تماشای فیلم آموزش کار با ربات»
# در منوی راهنمای ربات مشتری به همین لینک اشاره می‌کند (خالی = دکمه ساخته نمی‌شود).
# برای اینستنس‌های موجود پس از ست کردن، اسکریپت scripts/add_video_link.py را اجرا کنید.
VIDEO_LINK=

# --- پروکسی ---
PROXY_CHECK_INTERVAL=180
PROXY_CHECK_TIMEOUT=8
PROXY_DEAD_FAILS=3
PROXY_RECOVER_OKS=2
PROXY_WEAK_MS=1200
PROXY_CONCURRENCY=8
PROXY_USAGE_TYPE=login
PROXY_TEST_HOST=149.154.167.50
PROXY_TEST_PORT=443
PROXY_NOTIFY_HEARTBEAT=20
PROXIES_PER_INSTANCE=10

# --- 🎯 تخصیص پروکسی به هر اینستنس (مدیریت تفکیک‌شده ادمین) ---
# تخصیص خودکار هنگام ساخت اینستنس جدید (لاگین + سندر) — تا مشتری هیچ دخالتی نداشته باشد
AUTO_ASSIGN_ON_PROVISION=true
# تعداد پروکسی لاگین که خودکار به اینستنس جدید تخصیص می‌یابد (0 = خاموش)
AUTO_ASSIGN_LOGIN_COUNT=10
# تعداد پروکسی سندر که خودکار به اینستنس جدید تخصیص می‌یابد (0 = خاموش)
AUTO_ASSIGN_SENDER_COUNT=10
# حداکثر خط پروکسی در هر پیام ادمین
INSTANCE_PROXY_MAX_LINES=300
# هشدار کمبود: اگر سهمیه سالم لاگین یا سندر یک اینستنس کمتر از این عدد شود ادمین هشدار می‌گیرد
INSTANCE_PROXY_MIN_HEALTHY=3

# --- منابع اینستنس‌ها ---
# برای ۵۰ اینستنس همزمان: 50×512m = 25.6GB سقف RAM (سرور پیشنهادی: 32GB/8vCPU)
# اگر سرور 16GB دارید → INSTANCE_MEM_LIMIT=256m و INSTANCE_CPUS=0.25 بگذارید
INSTANCE_MEM_LIMIT=512m
INSTANCE_CPUS=0.5
INSTANCE_PIDS_LIMIT=200
INSTANCE_LOG_MAX_SIZE=20m
# پول اتصال هر اینستنس به MySQL مشترک (هر اینستنس حداکثر ۵+۱۰=۱۵ کانکشن)
INSTANCE_DB_POOL_SIZE=5
INSTANCE_DB_MAX_OVERFLOW=10

# --- دیپلوی ---
DEPLOY_STARTUP_TIMEOUT=120
# صف دیپلوی چندکارگره: ۵۰ سفارش همزمان بدون گم‌شدن هضم می‌شود (~۲۵ دقیقه با ۲ کارگر)
DEPLOY_QUEUE_WORKERS=2
DEPLOY_QUEUE_SIZE=200
INSTANCE_STARTUP_MARKER=Master Control Panel

# --- انقضا ---
EXPIRY_AUTO_STOP=false
EXPIRY_WARN_DAYS=3

# آدرس پروکسی خروجی برای اتصال ربات فروش به سرورهای تلگرام (برای اتصال مستقیم این مقدار را خالی بگذارید)
OUTBOUND_PROXY=http://127.0.0.1:10809

# --- پلن‌های فروش (در صورت خالی بودن، پلن‌های پیش‌فرض کد اعمال می‌شود) ---
# ⚠️ قیمت‌ها به «سنت» هستند: 3.5 دلار = 350 | 6.5 دلار = 650 | 9 دلار = 900 | 17 دلار = 1700
# PLANS_JSON={"monthly":{"title":"یک‌ماهه","price":350,"days":30,"desc":""},"bimonthly":{"title":"دوماهه","price":650,"days":60,"desc":""},"quarterly":{"title":"سه‌ماهه","price":900,"days":90,"desc":""},"semiannual":{"title":"شش‌ماهه","price":1700,"days":180,"desc":""}}
