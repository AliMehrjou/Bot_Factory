# 🏛 تنظیمات MySQL مشترک ربات‌ساز
# تله شماره ۲ (عدد طلایی — نسخه ۵۰ سفارش):
#   هر اینستنس با POOL_SIZE=5 + MAX_OVERFLOW=10 حداکثر ۱۵ کانکشن می‌خواهد.
#   با ۵۰ کانکشن رزرو برای فکتوری: (1000-50)÷15 = ۶۳ اینستنس فعال.
#   → max_connections=1000 برای ۵۰ سفارش همزمان کافی است.
#   بدون این تنظیم، mysql پیش‌فرض (151) بعد از ~۶ مشتری خطای Too many connections می‌دهد.
#   ⚠️ این عدد باید با MYSQL_MAX_CONNECTIONS فایل .env یکی باشد.

[mysqld]
max_connections      = 1000
wait_timeout         = 300
interactive_timeout  = 300
max_connect_errors   = 100000
table_open_cache     = 4000
open_files_limit     = 65535

# UTF-8 کامل برای فارسی
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# لاگ آرام‌تر (اختیاری)
log_error_verbosity  = 1
